FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-full.txt ./
RUN pip install --no-cache-dir -r requirements-full.txt
COPY app ./app
COPY workers ./workers
RUN useradd --create-home --uid 10001 athena && chown -R athena:athena /app
USER athena
# -c 4 concurrency; acks_late means a task killed mid-run is redelivered, which
# is safe only because these tasks are idempotent.
CMD ["celery", "-A", "workers.tasks.celery_app", "worker", "--loglevel=info", "-c", "4", "-Q", "default,training"]
