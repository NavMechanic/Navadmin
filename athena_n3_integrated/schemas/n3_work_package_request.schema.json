{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schema:n3_work_package_request",
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "ELECTRICAL_SCHEMATIC",
        "PCB_LAYOUT",
        "DFM",
        "CIRCUIT_SIMULATION",
        "MECHANICAL",
        "THERMAL"
      ],
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "budget_cap": {
      "$ref": "#/$defs/Money"
    },
    "due_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due Date"
    },
    "acceptance_notes": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acceptance Notes"
    }
  },
  "required": [
    "baseline_id",
    "kind",
    "budget_cap"
  ],
  "title": "N3WorkPackageRequest",
  "type": "object"
}
