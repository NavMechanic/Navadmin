{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schema:n3_assessment",
  "$defs": {
    "N3FileEvidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "SCHEMATIC",
            "PCB",
            "PROJECT",
            "GEOMETRY",
            "NETLIST",
            "GERBER",
            "DRILL",
            "ODB",
            "BOM",
            "ERC_REPORT",
            "DRC_REPORT",
            "SIM_LOG",
            "SIM_RAW",
            "THERMAL_REPORT",
            "DOCUMENT",
            "IMAGE",
            "OTHER"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "blob_id": {
          "title": "Blob Id",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "native": {
          "title": "Native",
          "type": "boolean"
        },
        "detected_format": {
          "title": "Detected Format",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "origin": {
          "enum": [
            "VENDOR",
            "TOOL_JOB",
            "ENGINEER"
          ],
          "title": "Origin",
          "type": "string"
        },
        "delivery_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "blob_id",
        "uri",
        "size_bytes",
        "native",
        "detected_format",
        "origin"
      ],
      "title": "N3FileEvidence",
      "type": "object"
    },
    "N3Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "BLOCK",
            "REWORK",
            "INFO"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "description": "file paths / SHA-256s the finding rests on",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "refdes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refdes"
        },
        "corner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corner"
        }
      },
      "required": [
        "finding_id",
        "code",
        "severity",
        "outcome",
        "category",
        "message"
      ],
      "title": "N3Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "N3Assessment.v1",
      "default": "N3Assessment.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "work_package_id": {
      "title": "Work Package Id",
      "type": "string"
    },
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "scope": {
      "enum": [
        "schematic_pcb",
        "circuit_simulation",
        "mechanical_thermal"
      ],
      "title": "Scope",
      "type": "string"
    },
    "kind": {
      "enum": [
        "ELECTRICAL_SCHEMATIC",
        "PCB_LAYOUT",
        "DFM",
        "CIRCUIT_SIMULATION",
        "MECHANICAL",
        "THERMAL"
      ],
      "title": "Kind",
      "type": "string"
    },
    "design_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Design Revision"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/N3FileEvidence"
      },
      "title": "Files",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/N3Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "decision": {
      "enum": [
        "PASS",
        "REWORK",
        "BLOCK"
      ],
      "title": "Decision",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "assessed_by": {
      "title": "Assessed By",
      "type": "string"
    },
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "assessment_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Sha256"
    },
    "approval_scope": {
      "default": "N3 approval means this design package is suitable for the next controlled engineering step (N4 verification / N5 sourcing). It is NOT product safety certification, laboratory qualification or mass-manufacturing release.",
      "title": "Approval Scope",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "tenant_id",
    "work_package_id",
    "baseline_id",
    "scope",
    "kind",
    "design_revision",
    "files",
    "findings",
    "decision",
    "metrics",
    "engine_version",
    "assessed_by",
    "assessed_at"
  ],
  "title": "N3Assessment",
  "type": "object"
}
