{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schema:n3_design_baseline",
  "$defs": {
    "Derivation": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "computed_by": {
          "default": "n0-deterministic",
          "title": "Computed By",
          "type": "string"
        }
      },
      "required": [
        "formula",
        "inputs"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DesignConstraints": {
      "additionalProperties": false,
      "description": "Engineering constraints N2 locks into the PRD; N3 verifies designs against them.",
      "properties": {
        "input_voltage_min_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Voltage Min V"
        },
        "input_voltage_max_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Voltage Max V"
        },
        "ambient_min_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Min C"
        },
        "ambient_max_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Max C"
        },
        "load_max_a": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Max A"
        },
        "load_max_w": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Max W"
        },
        "derating_factor": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Derating Factor",
          "type": "number"
        },
        "min_clearance_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Clearance Mm"
        },
        "min_creepage_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Creepage Mm"
        },
        "thermal_margin_c": {
          "default": 10.0,
          "minimum": 0,
          "title": "Thermal Margin C",
          "type": "number"
        },
        "max_pcb_layers": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pcb Layers"
        }
      },
      "title": "DesignConstraints",
      "type": "object"
    },
    "EvidenceSnippet": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "description": "blob_id, file URI or 'payload'",
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        }
      },
      "required": [
        "source_ref",
        "text"
      ],
      "title": "EvidenceSnippet",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "One value. ``value_origin`` says who stated it: the customer, a measurement, N0's own\ndeterministic derivation, or a model extraction awaiting human confirmation.",
      "properties": {
        "schema_version": {
          "const": "Requirement.v1",
          "default": "Requirement.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "req_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{1,127}$",
          "title": "Req Id",
          "type": "string"
        },
        "parameter": {
          "description": "snake_case with a unit suffix, e.g. output_voltage_v",
          "pattern": "^[a-z][a-z0-9_]{1,79}$",
          "title": "Parameter",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "tolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operating_conditions": {
          "additionalProperties": true,
          "title": "Operating Conditions",
          "type": "object"
        },
        "value_origin": {
          "enum": [
            "CUSTOMER",
            "MEASURED",
            "DERIVED",
            "MODEL_EXTRACTED"
          ],
          "title": "Value Origin",
          "type": "string"
        },
        "evidence_snippets": {
          "items": {
            "$ref": "#/$defs/EvidenceSnippet"
          },
          "title": "Evidence Snippets",
          "type": "array"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "si_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Si Value"
        },
        "si_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Si Unit"
        }
      },
      "required": [
        "req_id",
        "parameter",
        "value",
        "value_origin"
      ],
      "title": "Requirement.v1",
      "type": "object"
    },
    "TestLimit": {
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "pattern": "^[a-z][a-z0-9_]{1,79}$",
          "title": "Parameter",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "requirement_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Ref"
        }
      },
      "required": [
        "parameter"
      ],
      "title": "TestLimit",
      "type": "object"
    },
    "Tolerance": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ABS",
            "PCT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "plus": {
          "title": "Plus",
          "type": "number"
        },
        "minus": {
          "title": "Minus",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "plus",
        "minus"
      ],
      "title": "Tolerance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "N3DesignBaseline.v1",
      "default": "N3DesignBaseline.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "prd_id": {
      "title": "Prd Id",
      "type": "string"
    },
    "prd_artifact": {
      "description": "PRD ARTIFACT_ID@REVISION",
      "title": "Prd Artifact",
      "type": "string"
    },
    "prd_revision": {
      "title": "Prd Revision",
      "type": "string"
    },
    "prd_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prd Payload Sha256",
      "type": "string"
    },
    "prd_release_id": {
      "title": "Prd Release Id",
      "type": "string"
    },
    "prd_manifest_id": {
      "title": "Prd Manifest Id",
      "type": "string"
    },
    "prd_approval_id": {
      "title": "Prd Approval Id",
      "type": "string"
    },
    "prd_approval_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prd Approval Hash",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "design_source_id": {
      "title": "Design Source Id",
      "type": "string"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "design_scopes": {
      "items": {
        "enum": [
          "schematic_pcb",
          "circuit_simulation",
          "mechanical_thermal"
        ],
        "type": "string"
      },
      "title": "Design Scopes",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/DesignConstraints"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "test_limits": {
      "items": {
        "$ref": "#/$defs/TestLimit"
      },
      "title": "Test Limits",
      "type": "array"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "locked_by": {
      "title": "Locked By",
      "type": "string"
    },
    "locked_at": {
      "format": "date-time",
      "title": "Locked At",
      "type": "string"
    },
    "baseline_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Sha256"
    },
    "approval_scope": {
      "default": "N3 approval means this design package is suitable for the next controlled engineering step (N4 verification / N5 sourcing). It is NOT product safety certification, laboratory qualification or mass-manufacturing release.",
      "title": "Approval Scope",
      "type": "string"
    }
  },
  "required": [
    "baseline_id",
    "tenant_id",
    "prd_id",
    "prd_artifact",
    "prd_revision",
    "prd_payload_sha256",
    "prd_release_id",
    "prd_manifest_id",
    "prd_approval_id",
    "prd_approval_hash",
    "project_id",
    "design_source_id",
    "product_name",
    "design_scopes",
    "constraints",
    "requirements",
    "test_limits",
    "synthetic",
    "locked_by",
    "locked_at"
  ],
  "title": "N3DesignBaseline",
  "type": "object"
}
