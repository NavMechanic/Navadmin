# development | production  (production refuses the dev JWT secret and demo users)
PILOT_ENV=development
DATABASE_URL=sqlite:///./pilot.db
# DATABASE_URL=postgresql+psycopg://pilot:pilot@localhost:5432/pilot
PILOT_JWT_SECRET=change-me-to-at-least-32-random-characters
PILOT_JWT_TTL_MINUTES=60
PILOT_SEED_DEMO=true

# LLM gateway: "local" (offline, zero cost) or "anthropic" (needs `pip install anthropic`
# and credentials, e.g. ANTHROPIC_API_KEY or an `ant auth login` profile)
LLM_PROVIDER=local
# Per-task routing overrides (JSON). Every task defaults to claude-opus-5-5.
# LLM_ROUTES_JSON={"rfq_extraction": {"model": "claude-haiku-5-5", "effort": "low"}}
PILOT_LLM_BUDGET_USD=25

# Gates and calculations
PILOT_GST_RATE=0.18
PILOT_EXTRACTION_ACCURACY_GATE=0.90
PILOT_PFMEA_RPN_THRESHOLD=200

# Orchestration
PILOT_STEP_LEASE_SECONDS=300
PILOT_RETRY_BACKOFF_SECONDS=0
PILOT_VENDOR_OUTBOX=./var/vendor_outbox
