# Copy this file to .streamlit/secrets.toml and fill in your values.
# DO NOT commit secrets.toml to git — it is in .gitignore.

# Required: Claude API key for RAG generation
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: Google Drive integration for live PDF sync
# Leave empty to use local mirror / simulation mode
GOOGLE_DRIVE_CREDENTIALS = ""

# Optional: Override Qdrant URL (defaults to in-memory)
# QDRANT_URL = "https://your-cluster.qdrant.io"
# QDRANT_API_KEY = "your-qdrant-api-key"
