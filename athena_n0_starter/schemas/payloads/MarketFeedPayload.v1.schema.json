{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:n0:schema:MarketFeedPayload.v1",
  "$defs": {
    "SeriesPoint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "SeriesPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "feed_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{1,127}$",
      "title": "Feed Id",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/SeriesPoint"
      },
      "minItems": 1,
      "title": "Series",
      "type": "array"
    }
  },
  "required": [
    "feed_id",
    "as_of",
    "series"
  ],
  "title": "MarketFeedPayload.v1",
  "type": "object"
}
