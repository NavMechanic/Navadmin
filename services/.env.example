# Project Athena — Environment Configuration

# Gateway
ATHENA_ENVIRONMENT=dev
ATHENA_LOG_LEVEL=INFO
ATHENA_GATEWAY_TIMEOUT=60
ATHENA_GATEWAY_HEALTH_TIMEOUT=5
ATHENA_BREAKER_THRESHOLD=5
ATHENA_BREAKER_COOLDOWN=20
ATHENA_REQUIRE_AUTH=true
ATHENA_JSON_LOGS=false

# Node URLs (for local Docker)
ATHENA_NODE1_URL=http://node1:8001
ATHENA_NODE2_URL=http://node2:8002
ATHENA_NODE3_URL=http://node3:8003
ATHENA_NODE4_URL=http://node4:8004
ATHENA_NODE5_URL=http://node5:8005
ATHENA_NODE6_URL=http://node6:8006

# Infrastructure
ATHENA_REDIS_URL=redis://redis:6379/0
ATHENA_KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
ATHENA_DATABASE_URL=postgresql://athena:athena@postgres:5432/athena

# Integrations
ATHENA_OPCUA_ENDPOINT=  # Leave empty for simulator
ATHENA_ANSYS_CLOUD=false
ATHENA_TIMESCALE_REQUIRED=false
