# Athena Node 2 — copy to .env and edit. Every setting is prefixed ATHENA_.

# ---------------------------------------------------------------- service
ATHENA_ENVIRONMENT=dev
ATHENA_LOG_LEVEL=INFO
ATHENA_API_PREFIX=/api/v1
# ATHENA_CORS_ORIGINS=["https://athena.internal"]

# ---------------------------------------------------------------- database
# Must use an async driver — the service refuses to start otherwise, because a
# sync driver deadlocks the event loop the first time two requests overlap.
ATHENA_DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:5432/athena_plm
# No-server fallback for a laptop demo or the test suite:
# ATHENA_DATABASE_URL=sqlite+aiosqlite:///./athena_plm.db
ATHENA_DB_ECHO=false
ATHENA_DB_POOL_SIZE=10
ATHENA_DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- auth
# HS256 with a shared secret keeps the demo self-contained. In production point
# these at the corporate IdP (RS256 + JWKS) and do not mount /auth/token.
ATHENA_JWT_SECRET=change-me-at-least-32-bytes-long-please
ATHENA_JWT_ALGORITHM=HS256
ATHENA_JWT_ISSUER=athena.plm
ATHENA_JWT_AUDIENCE=athena.node2
ATHENA_JWT_TTL_MINUTES=480
# false admits unauthenticated callers as read-only viewers — never in production
ATHENA_AUTH_REQUIRED=true

# ---------------------------------------------------------------- gate policy
# The real minimum depends on working voltage, pollution degree and material
# group. This is the programme's stated figure for the 20 W adapter and is
# configurable precisely because it must come from the safety assessment.
ATHENA_CREEPAGE_MIN_MM_ADAPTER=3.0
ATHENA_CREEPAGE_GUARD_BAND_PCT=20
# AIAG-VDA requires a responsible *person*; a department cannot be held to a date
ATHENA_FMEA_HIGH_AP_REQUIRES_NAMED_OWNER=true
ATHENA_ENFORCE_CHILD_GATE_PRECEDENCE=true
# A certificate that lapses mid-ramp is not a certificate you have
ATHENA_CERTIFICATE_MIN_VALIDITY_DAYS=90

# ---------------------------------------------------------------- vaults
ATHENA_CAD_VAULT_WEBHOOK_SECRET=change-me-cad-vault-secret
ATHENA_WEBHOOK_MAX_SKEW_SECONDS=300
# ATHENA_CAD_VAULT_BASE_URL=https://plmvault.internal
# Leave the compliance URL blank to replay local certificate state instead of
# verifying against the issuing authority. /health reports which mode is active.
# ATHENA_COMPLIANCE_VAULT_BASE_URL=https://compliance.internal
# ATHENA_COMPLIANCE_VAULT_API_KEY=
ATHENA_HTTP_TIMEOUT_SECONDS=15
